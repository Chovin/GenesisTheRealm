---
import { getCollection, render } from 'astro:content';
import fs from 'fs';
import { rand } from '../utils/rand.js'
import Head from '../components/Head.astro'
import Footer from '../components/Footer.astro'
import Scripts from '../components/Scripts.astro'
import MemberArticle from '../components/MemberArticle.astro';

const seasonsDescs = await getCollection('seasons');
seasonsDescs.sort((a, b) => parseInt(a.id) - parseInt(b.id))
seasonsDescs.reverse()

const regionDescs = await getCollection('regions')
regionDescs.sort((a, b) => parseInt(a.id.split(' ')[0]) - parseInt(b.id.split(' ')[0]))

const eventsDescs = await getCollection('events')
eventsDescs.sort((a, b) => parseInt(a.id.split(' ')[0]) - parseInt(b.id.split(' ')[0]))

const members = await getCollection('members')

const BG_COLORS = [
    '#4c5c96',
    '#45558d',
    '#3f4e85'
]
let prevColor = ''
---
<Head/>

<body class="is-preload">

	<!-- Page Wrapper -->
	<div id="page-wrapper">
		<!-- Header -->
		<header id="header" class="alt">
			<h1><a href="index.html">Genesis Realm 🌱</a></h1>
			<nav>
				<a href="#menu">Menu</a>
			</nav>
		</header>

		<!-- Menu -->
		<nav id="menu">
			<div class="inner">
				<h2>Menu</h2>
				<ul class="links">
					<li><a href="apply.html">Apply</a></li>
					<li><a href="#contact">Contact</a></li>
				</ul>
				<a  class="close">Close</a>
			</div>
		</nav>

		<!-- Banner -->
		<section id="banner">
			<div class="inner">
				<div class="logo"><img src="images/GenesisLogo.webp"></img></div>
				<h2>Genesis 🌱</h2>
				<p>A Vanilla Survival Bedrock Realm est. 2016</p>
			</div>
		</section>

		<!-- Content -->
		<div class="wrapper" >
			<div class="inner">
				<section>
					<h2 class="major">About Us</h3>
						<p>
						Genesis is a survival bedrock realm founded in June of 2016. Our realm features pure vanilla
						gameplay on hard difficulty, with achievements enabled!
						<br> <br>
						We're a tight-knit community of players from all over the world, each with their own play style,
						interests, and strengths. We value community and collaboration, creativity, and respect. Genesis
						has had setbacks and challenges over the years, but we meet those challenges head-on and
						continue to evolve and improve to the best of our ability. We're fun, goofy, and a family-like
						group who really enjoy playing Minecraft together!
						</p>
				</section>
			</div>
		</div>

		<!-- Wrapper -->
		<section id="wrapper">
			{
			regionDescs.map(async (rd) => {
				const { Content } = await render(rd)
				
				let color_choices = [...BG_COLORS].filter(c => c !== prevColor)
				// this rand is supposed to be seeded with a constant seed
				// so why do the colors keep changing?
				let color = color_choices[~~(rand()*color_choices.length)]
				prevColor = color

				return (
					<section id={rd.data.images} class="wrapper spotlight dynamic" style={`--bg-color: ${color}`}>
						<div class="inner">
							{ rd.data.img && <a  class="image"><img src={`images/Regions/${rd.data.images}/${rd.data.img}`} alt="" /></a>}
							<div class="content">
								<h2 class="major">{rd.data.title}</h2>
								<Content />
								{ rd.data.images && <a href={`regions/${rd.data.images}?crumb=index.html&id=${rd.data.images}`} class="special">Picture album</a> }
							</div>
						</div>
					</section>
				)
			})}

			<!-- Six -->
			<section id="six" class="wrapper alt style1">
				<div class="inner">
					<h2 class="major">Realm Events</h2>
					<section class="features" style="margin-bottom: 0%">
						{eventsDescs.map(async (ed) => {
							const { Content } = await render(ed)
							return (
								<article>
									<a class="image"><img src={`images/RealmEvents/${ed.data.img}`} alt={ed.data.title} /></a>
									<h3 class="major">{ed.data.title}</h3>
									<p>
										<Content/>
									</p>
								</article>
							)
						})}
					</section>
				</div>

				<div class="inner">
					<h2 id="seasons" class="major">Seasonal Albums</h2>
					<p>
						View Genesis throughout the years! <br>
						<b>Builds:</b> Our lovely and creative members (Thank you for all your hard work in making Genesis what it is!) <br>
						<b>Photographers: </b> Samb2o and TheMoonTyrant
					</p>
					<section class="features">
						{seasonsDescs.map(async (sd) => {
							const { Content } = await render(sd)
							const images = fs.readdirSync(`public/images/Seasons/${sd.id}`).filter(file => /\.(png|jpe?g|webp)$/i.test(file));
							let thumb = sd.data.img
							if (!thumb) {
								thumb = images[~~(Math.random()*images.length)]
							}
							return (
								<article id={`season${sd.id}`}>
									<a class="image"><img src={`images/Seasons/${sd.id}/${thumb}`} alt="" /></a>
									<h3 class="major">Season {sd.id}</h3>
									<Content />
									{images.length > 1 && <a href={`seasons/${sd.id}.html?crumb=index.html&id=season${sd.id}`} class="special">Photo album</a>}
								</article>
							)
						})}
					</section>
					<!-- <ul class="actions">
						<li><a class="button">Browse All</a></li>
					</ul> -->
				</div>
				<div class="inner">
					<h2 id="members" class="major">A Few of Our Members</h2>
					<div class="glide">
						<div class="glide__track" data-glide-el="track">
							<ul class="glide__slides member-slides">
								{members.map(async (md) => {
									const { Content } = await render(md)
									return (
										<li class="glide__slide">
											<MemberArticle 
												id={md.id}
												name={md.data.name}
												img={md.data.img}
											>
												<Content />
											</MemberArticle>
										</li>
									)
								})}
							</ul>
						</div>
						<div class="glide__arrows" data-glide-el="controls">
							<button class="glide__arrow glide__arrow--left" data-glide-dir="<"></button>
							<button class="glide__arrow glide__arrow--right" data-glide-dir=">"></button>
						</div>
					</div>
				</div>
			</section>
		</div>
	</div>


	</section>

	<Footer/>
	</div>

	<Scripts/>

</body>

<script>
	let ul = document.querySelector('ul.member-slides');
	for (let i = ul.children.length; i >= 0; i--) {
		ul?.appendChild(ul.children[Math.random() * i | 0])
	}

	new Glide('.glide', {
		perView: 2,
		focusAt: 'center',
		autoplay: 2000,
		type: 'carousel',
		gap: 40,
		breakpoints: {
			736: {
				perView: 1
			}
		}
	}).mount()
</script>

<style>
.glide__arrow {
	position: absolute;
	top: 50%;
	padding: 0;
	box-shadow: none;
	height: 2rem;
	margin-top: -1rem;	
}
.glide__arrow:hover {
	background-color: inherit;
}
.glide__arrow::after {
	font-family: 'Font Awesome 5 Free';
	transition: background-color 0.2s ease-in-out;
    border-radius: 100%;
    border: solid 2px rgba(255, 255, 255, 0.125);
    content: '\f105';
    display: inline-block;
    font-size: 1.25em;
    height: 2em;
    line-height: 1.75em;
    text-align: center;
    text-indent: 0.15em;
    vertical-align: middle;
    width: 2em;
}
.glide__arrow:hover::after {
	background-color: rgba(255, 255, 255, 0.025)
}

.glide__arrow--left {
	left: 0rem;
}
.glide__arrow--left::after {
	content: '\f104';
}

.glide__arrow--right {
	right: 0rem;
}
.glide__arrow--right::after {
	content: '\f105';
}

.glide__track {
	position: relative;
	z-index: 0;
}

.glide__track::after, .glide__track::before {
    /* content: ""; */
    content: "";
    position: absolute;
    height: 100%;
    width: 3em;
    z-index: 1;
	top: 0;
}
.glide__track::after {
	right: 0;
    background: linear-gradient(90deg, rgba(46, 49, 65, 0) 0%, rgba(46, 49, 65, 1) 100%);
}

.glide__track::before {
	left: 0;
    background: linear-gradient(90deg, rgba(46, 49, 65, 1) 0%, rgba(46, 49, 65, 0) 100%);
}

@media screen and (max-width: 736px) {
	.glide__track::before, .glide__track::after {
		display: none;
	}
}

</style>
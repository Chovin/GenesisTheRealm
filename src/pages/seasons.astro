---
import { getCollection, render } from 'astro:content';
import fs from 'fs';

import Head from '../components/Head.astro'
import Footer from '../components/Footer.astro'
import Scripts from '../components/Scripts.astro'

const seasonsDescs = await getCollection('seasons');
seasonsDescs.sort((a, b) => parseInt(a.id) - parseInt(b.id))
seasonsDescs.reverse()
---
<Head/>

<body class="is-preload">

	<!-- Page Wrapper -->
	<div id="page-wrapper">
		<!-- Header -->
        <header id="header">
            <h1><a href="index.html">Photo Wall</a></h1>
            <nav>
                <a href={`index.html#seasons`} class="button fit">Home</a>
            </nav>
        </header>
        

        <section id="wrapper">
            <header>
                <div class="inner">
                    <h2>Seasonal Albums</h2>
                    <p>View Genesis throughout the years!</p>
                </div>
            </header>
            <section id="six" class="wrapper alt style1">

                <section id="six" class="wrapper alt style1">
                    <div class="inner">
                        <p>
                            Genesis has been around since the early days of Realms. 
                            About once a year, we wipe the realm clean and begin a new world, 
                            Each new world is called a <i>season</i>.
                        </p>
                        <p>
                            Over the years, our community has created an incredible collection of iconic builds. 
                            Here, you can browse through albums showcasing past seasons and see how Genesis 
                            has grown and evolved over time.
                        </p>
                        <p>
                            <b>Builds:</b> Our lovely and creative members (Thank you for all your hard work in making Genesis what it is!) <br>
                            <b>Photographers: </b> Samb2o and TheMoonTyrant
                        </p>
                        <section class="features">
                            {seasonsDescs.map(async (sd) => {
                                const { Content } = await render(sd)
                                const images = fs.readdirSync(`public/images/Seasons/${sd.id}`).filter(file => /\.(png|jpe?g|webp)$/i.test(file));
                                let thumb = sd.data.img
                                if (!thumb) {
                                    thumb = images[~~(Math.random()*images.length)]
                                }
                                return (
                                    <article id={`season${sd.id}`}>
                                        <a class="image"><img src={`images/Seasons/${sd.id}/${thumb}`} alt="" /></a>
                                        <h3 class="major">Season {sd.id}</h3>
                                        <Content />
                                        {images.length > 1 && <a href={`seasons/${sd.id}.html?crumb=seasons.html&id=season${sd.id}`} class="special">Photo album</a>}
                                    </article>
                                )
                            })}
                        </section>
                    </div>
                </section>
            </section>
        </section> 
    </div>
    <Footer/>
    <Scripts/>
</body>